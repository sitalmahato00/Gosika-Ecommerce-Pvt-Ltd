# ---------------------------------------------------------------------------
# Frontend Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env (local dev) or .env.production (production build)
# ---------------------------------------------------------------------------

# Only needed for local dev (vite dev server proxy target).
# In production, the React build is served by Laravel at the same origin,
# so no proxy is used and this variable is ignored.
VITE_API_URL=http://127.0.0.1:8000
