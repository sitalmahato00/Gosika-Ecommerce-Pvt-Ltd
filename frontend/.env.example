# ---------------------------------------------------------------------------
# Frontend Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env (local dev) or .env.production (production build)
# ---------------------------------------------------------------------------

# Only needed for local dev (vite dev server proxy target).
# In production, the React build is served by Laravel at the same origin,
# so no proxy is used and this variable is ignored.
VITE_API_URL=http://127.0.0.1:8000

# These must match the Reverb app key and public connection settings in the
# backend .env file. The app secret must never be added to this frontend file.
VITE_REVERB_APP_KEY=gosika-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
